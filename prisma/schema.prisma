// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussions Discussion[]
  replies     Reply[]

  @@map("users")
}

model Discussion {
  id          String   @id @default(cuid())
  title       String   // Discussion title
  content     String   // Discussion content
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     Reply[]  // All replies on this discussion

  @@map("discussions")
}

model Reply {
  id            String   @id @default(cuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  // Self-referencing for nested replies
  parentId      String?
  parent        Reply?    @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Reply[]   @relation("ReplyTree")

  // Reply content
  content       String   // Reply content

  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("replies")
}