// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussions Discussion[]
  operations  Operation[]

  @@map("users")
}

model Discussion {
  id          String   @id @default(cuid())
  startNumber Float    // The starting number for calculation tree
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operations Operation[] // All operations on this discussion tree

  @@map("discussions")
}

model Operation {
  id            String   @id @default(cuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  
  // Self-referencing for tree structure
  parentId      String?
  parent        Operation?  @relation("OperationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Operation[] @relation("OperationTree")

  // Operation details
  operationType String   // "ADD", "SUBTRACT", "MULTIPLY", "DIVIDE"
  rightOperand  Float    // User-chosen number (right side of operation)
  result        Float    // Calculated result

  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("operations")
}